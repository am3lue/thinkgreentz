# Turso Database (https://turso.tech)
# Create a free database and generate an API token from the Turso dashboard.
TURSO_URL="libsql://your-database-name.aws-us-east-1.turso.io"
TURSO_API_KEY="your-turso-api-token"

# ImgBB API (https://api.imgbb.com)
# Used for image uploads in the admin CMS. Get a free API key from api.imgbb.com.
IMGBB_API_KEY="your-imgbb-api-key"

# ─────────────────────────────────────────────
# Email (SMTP) — for future contact/volunteer notifications
# Uncomment and configure when ready to enable email.
# See: server/utils/mail.ts (placeholder file)
# ─────────────────────────────────────────────
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-gmail-app-password"
